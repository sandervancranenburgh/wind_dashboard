*/6 7-22 * * * cd /home/sandervancranenburgh/Documents/repos/wind_fetcher2 && /home/sandervancranenburgh/Documents/repos/wind_fetcher2/scripts/run_wind_dashboard_pipeline.sh >> /home/sandervancranenburgh/Documents/repos/wind_fetcher2/wind_pipeline_cron.log 2>&1

